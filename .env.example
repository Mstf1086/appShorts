# API Keys - Add your keys here
GEMINI_API_KEY=your_gemini_api_key_here

# Optional image-generation tuning (defaults shown)
# IMAGE_PROVIDER=cloudflare                        # "cloudflare" (default) | "gemini"
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image            # or "model1,model2" failover list
# IMAGE_CANDIDATES=1                                   # candidates per scene (1 = one image each)
# APPROVE_IMAGES=false                                 # TTY confirm/change/skip loop
# IMAGE_FALLBACK_POLLINATIONS=true                     # keyless fallback (Cloudflare path + quota)
# POLLINATIONS_TIMEOUT=90
# IMAGE_FALLBACK_GEMINI=true                            # Gemini fallback in the Cloudflare path
# IMAGE_FALLBACK_CLOUDFLARE=true                    # token fallback on quota
# Anahtarsız kullanım: cf auth login (veya generate_shorts.py --cf-login)
# OAuth profili kullanılırken ortamdaki geçersiz token kaldırılır.
# CLOUDFLARE_CLI_COMMAND=cf
# CLOUDFLARE_CLI_PROFILE=                             # opsiyonel adlı profil
# CLOUDFLARE_CLI_TIMEOUT=120
# TEXT_PROVIDER=gemini                          # CLI default; Web UI Workers AI seçimi bunu açıkça geçersiz kılar
# CLOUDFLARE_TEXT_MODEL=@cf/meta/llama-3.2-3b-instruct
# REST alternatifi (opsiyonel):
# CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
# CLOUDFLARE_API_TOKEN=your_workers_ai_token       # Workers AI Read+Edit
# CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
# CLOUDFLARE_IMAGE_STEPS=4
# CLOUDFLARE_TIMEOUT=90

# Optional subtitle font override
# SUBTITLE_FONT=/path/to/Font-Bold.ttf

# Voice / TTS generation settings
# TTS engine:
#   "edge"       - edge-tts, free, needs services.google.com (default, returns per-word timings)
#   "cloudflare" - Workers AI Melotts (cf OAuth veya REST token; Turkish unsupported)
#   "ttsai"      - tts.ai quality voice, free tier (15k chars/day) needs TTS_AI_API_KEY
#   "pockettts"  - offline Türkçe Pocket TTS (CPU), 6 ses + 5 duygu + ses klonlama;
#                  ilk koşuda ~440 MB model indirir, sonrası tamamen çevrimdışı
TTS_PROVIDER=edge
# Edge TTS 403/throttle backoff
TTS_MAX_RETRIES=5
TTS_RETRY_BASE_DELAY=3.0  # s, exponential: base * 2**attempt
TTS_SCENE_DELAY=1.5  # s between scenes
# Cloudflare Workers AI text-to-speech model
CLOUDFLARE_TTS_MODEL=@cf/myshell-ai/melotts
CLOUDFLARE_TTS_LANGUAGE=en                  # Melotts: en/es/fr/jp/kr/zh
CLOUDFLARE_TTS_TIMEOUT=120
# TTS.ai (better quality) - get a free API key at https://tts.ai/account
# TTS_AI_API_KEY=sk-tts-your-api-key-here
# TTS_AI_MODEL=kokoro     # free models: piper | vits | melotts | kokoro
# Pocket TTS Turkish (TTS_PROVIDER=pockettts) - offline, model: wite-tech/pocket-tts-turkish
# POCKET_TTS_VOICE=female_1          # female_1..3 | male_1..3
# POCKET_TTS_EMOTION=                # boş = nötr; mutlu | üzgün | kızgın | şaşkın | sakin
# POCKET_TTS_DEVICE=                 # boş = auto; "cpu" zorlamak için "cpu"
# POCKET_TTS_MODEL=                  # HF repo override (yerel/özel checkpoint)
# POCKET_TTS_VOICE_CLONE=            # 5-10 sn referans kayıt yolu (ses klonlama)
# POCKET_TTS_SEED=                   # tamsayı -> aynı metin + tohum = aynı ses
# Yerel motor sahneler arası bekleme istemez: TTS_SCENE_DELAY=0

# Gradio web UI (webui.py) — dışarıdan erişim
# GRADIO_HOST=0.0.0.0              # 0.0.0.0 = tüm arayüzlere dinle
# GRADIO_PORT=7860                    # tercih edilen port; doluysa sonraki boş port seçilir
# GRADIO_SHARE=true                # true = *.gradio.live public link üretir
# GRADIO_AUTH_USER=admin           # public link kullanıyorsan parola KOY
# GRADIO_AUTH_PASS=change-me
# GRADIO_TITLE=appShorts — YouTube Shorts Generator
# GRADIO_MAX_QUEUE=4
